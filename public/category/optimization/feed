							<div class="elementor-spacer">
			<div class="elementor-spacer-inner"></div>
		</div>
						</div>
				</div>
				<div class="elementor-element-custom_font_size elementor-element-custom_line_height elementor-element elementor-element-8aaebcb elementor-widget elementor-widget-text-editor" data-id="8aaebcb" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<blockquote><p style="text-align: center">Cum et essent similique. Inani propriae menandri sed in. Pericula expetendis has no,<br />quo populo forensibus contentiones et, nibh error in per.</p><p style="text-align: center"><cite>Denis Robinson<br /></cite></p></blockquote>								</div>
				</div>
				<div class="elementor-element elementor-element-532aa95 elementor-widget elementor-widget-spacer" data-id="532aa95" data-element_type="widget" data-e-type="widget" data-widget_type="spacer.default">
